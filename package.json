{
  "name": "totally-not-a-virus",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "watch": "tsc --project tsconfig.json --watch",
    "typecheck": "tsc --project tsconfig.check.json",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "lint": "eslint . --max-warnings 0",
    "lint:markdown": "markdownlint-cli2",
    "lint:css": "stylelint \"**/*.css\" --allow-empty-input --max-warnings 0",
    "spellcheck": "cspell --dot --no-progress",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run lint && npm run lint:markdown && npm run lint:css && npm run spellcheck && npm run format:check && npm run typecheck && npm test && npm run build"
  },
  "devDependencies": {
    "@cspell/dict-de-de": "^4.1.3",
    "@jest/globals": "^29.7.0",
    "@types/node": "^22.0.0",
    "cspell": "^10.4.0",
    "eslint": "^9.39.5",
    "eslint-plugin-yml": "^1.19.1",
    "jest": "^29.7.0",
    "markdownlint-cli2": "^0.23.3",
    "prettier": "^3.9.10",
    "stylelint": "^17.16.0",
    "stylelint-config-standard": "^40.0.0",
    "ts-jest": "^29.4.15",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.2"
  },
  "dependencies": {
    "reflect-metadata": "^0.2.2",
    "typeorm": "^0.3.31",
    "vue": "^3.5.44"
  }
}
